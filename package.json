{
  "name": "matomeru",
  "version": "0.1.2",
  "engines": {
    "node": ">=24"
  },
  "description": "Local MTG bulk collection manager",
  "main": "./out/main/index.js",
  "author": "sebas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "release:publish": "npm run build && electron-builder --win --publish always",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=cjs --target=node24 --outfile=.verify.cjs --external:node-sqlite3-wasm --alias:@shared=./src/shared --log-level=warning && node .verify.cjs",
    "verify:record": "esbuild scripts/verify.ts --bundle --platform=node --format=cjs --target=node24 --outfile=.verify.cjs --external:node-sqlite3-wasm --alias:@shared=./src/shared --log-level=warning && node .verify.cjs --record",
    "probe:decks": "esbuild scripts/probe-decks.ts --bundle --platform=node --format=cjs --outfile=.probe.cjs --alias:@shared=./src/shared --external:node-sqlite3-wasm && node .probe.cjs",
    "check:geometry": "node scripts/check-geometry.cjs",
    "probe:foil": "esbuild scripts/probe-foil.ts --bundle --platform=node --format=cjs --target=node24 --outfile=.probe-foil.cjs --alias:@shared=./src/shared --external:node-sqlite3-wasm --log-level=warning && node .probe-foil.cjs",
    "probe:boosters": "esbuild scripts/probe-boosters.ts --bundle --platform=node --format=cjs --target=node24 --outfile=.probe-boosters.cjs --alias:@shared=./src/shared --external:node-sqlite3-wasm --log-level=warning && node .probe-boosters.cjs",
    "check:features": "node scripts/check-features.cjs",
    "probe:thranduil": "esbuild scripts/probe-thranduil.ts --bundle --platform=node --format=cjs --target=node24 --outfile=.probe-thr.cjs --alias:@shared=./src/shared --external:node-sqlite3-wasm --log-level=warning && node .probe-thr.cjs",
    "icon": "electron scripts/make-icon.cjs && node scripts/check-icon.cjs",
    "check:themes": "node scripts/check-themes.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-sqlite3-wasm": "^0.8.60",
    "papaparse": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "26.13.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
